{
	"$schema": "https://openapi.vercel.sh/vercel.json",
	"buildCommand": "vite build",
	"outputDirectory": "dist/web",
	"framework": null,
	"functions": {
		"api/translate.ts": {"includeFiles": "scripts/**"}
	},
	"rewrites": [
		{"source": "/__notion-sync/status", "destination": "/api/notion-sync/status"},
		{
			"source": "/__notion-sync/stories/:id",
			"destination": "/api/notion-sync/stories/:id"
		},
		{"source": "/__notion-sync/stories", "destination": "/api/notion-sync/stories"}
	]
}
