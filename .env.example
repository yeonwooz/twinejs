# 이 파일을 .env.local로 복사해서 값을 채우세요 (.env.local은 git에 커밋되지 않습니다).
#
# 회고 온보딩(`npm start`)에 필요한 값 3개:

# 1) Notion 통합 토큰. https://www.notion.so/my-integrations 에서 발급.
NOTION_TOKEN=

# 2) 회고가 담긴 루트 페이지. 링크를 그대로 붙여넣어도 되고 ID만 넣어도 됩니다.
#    (그 통합을 이 페이지에 Connections로 연결해 두세요.)
NOTION_RETRO_ROOT_PAGE_ID=

# 3) Anthropic API 키. https://console.anthropic.com/ 에서 발급.
ANTHROPIC_API_KEY=

# stories DB는 첫 `npm start` 때 루트 페이지 아래에 자동 생성되어
# 아래 줄로 이 파일에 기록됩니다. 수동으로 지정하려면 직접 채워도 됩니다.
# 스토리는 한 곳에만 저장하므로 **하나만** 적습니다. 그리고 그 DB가 위 NOTION_TOKEN
# 통합에 공유돼 있어야 합니다(노션에서 DB나 그 부모 페이지 → Connections → 통합 추가).
# 공유가 안 돼 있으면 쓰기가 매번 404로 실패하고 콘솔 경고만 남습니다.
# NOTION_STORIES_DB_ID=
